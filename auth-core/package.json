{
  "name": "@nexis/nexus-sign-auth-core",
  "version": "2.0.0-rc.2",
  "description": "NEXUS-SIGN Auth Core: transaction authorization and evidence service for bank integrations.",
  "author": "Nexis Trust Technologies AG",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsc -p tsconfig.json && node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.mjs\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/*.test.mjs\"",
    "test:vectors": "node test-vectors/check-signed-payload-vectors.mjs && node test-vectors/check-vector-copies.mjs",
    "check:openapi": "node scripts/check-openapi-routes.mjs",
    "check:repository": "bash scripts/check-repository.sh",
    "check:all": "npm run test && npm run test:vectors && npm run check:openapi && npm run check:repository",
    "smoke-test": "node scripts/e2e-smoke.mjs",
    "verify-evidence": "node scripts/verify-evidence.mjs",
    "generate:vectors": "node test-vectors/generate-signed-payload-vectors.mjs && node test-vectors/generate-device-protocol-vectors.mjs && node test-vectors/generate-secure-push-vectors.mjs && node test-vectors/generate-recovery-vectors.mjs",
    "register-client": "node dist/cli/registerClient.js",
    "create-admin-user": "node dist/cli/createAdminUser.js",
    "set-client-certificates": "node dist/cli/setClientCertificates.js",
    "seal-credential-baseline": "node dist/cli/sealCredentialBaseline.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "pg": "^8.12.0",
    "ioredis": "^5.4.1",
    "zod": "^4.6.5",
    "helmet": "^7.1.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "cbor": "^9.0.2",
    "pkcs11js": "^2.1.6",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.6",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
