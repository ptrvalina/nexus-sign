# Required: development | test | production. Production refuses to start
# while any production control is off (src/config/productionPosture.ts).
NODE_ENV=development
# Outside production, the development settings below (software HSM,
# attestation off, mTLS off, admin MFA off) need this explicit opt-in.
ALLOW_INSECURE_DEVELOPMENT=true
PORT=8080

DATABASE_URL=postgres://nexus:nexus@localhost:5432/nexus_sign
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_STATEMENT_TIMEOUT_MS=5000

REDIS_URL=redis://localhost:6379
REDIS_TLS_REQUIRED=false

# HSM (production: pkcs11). The token is selected by label, the key by label
# and optional CKA_ID (hex); both must be unique on the token.
HSM_ADAPTER=software
PKCS11_MODULE_PATH=
PKCS11_TOKEN_LABEL=
PKCS11_SLOT_INDEX=0
PKCS11_PIN=
PKCS11_EVIDENCE_KEY_LABEL=
PKCS11_EVIDENCE_KEY_ID=
PKCS11_EVIDENCE_KEY_VERSION=1
HSM_SESSION_POOL_SIZE=4
HSM_OPERATION_TIMEOUT_MS=5000
# PEM public keys of retired sealing keys, so chains sealed before a key
# rotation still verify (docs/operations/runbooks/key-rotation.md).
EVIDENCE_RETIRED_PUBLIC_KEYS_PEM=

OAUTH_TOKEN_TTL_SECONDS=3600
REQUIRE_IDEMPOTENCY_KEY=true

# 32 random bytes, base64 (openssl rand -base64 32) for each master key.
WEBHOOK_SECRET_ENCRYPTION_KEY=
# Needed for offline confirmation and secure push.
DEVICE_SECRET_ENCRYPTION_KEY=
# Encrypts admin TOTP secrets; required in production.
ADMIN_SECRET_ENCRYPTION_KEY=
OFFLINE_CONFIRMATION_ENABLED=false
# Required in production with offline confirmation: highest amount per currency, minor units (FI-004).
# OFFLINE_CONFIRMATION_MAX_AMOUNT=PLN:100000,EUR:20000
DEVICE_REQUEST_MAX_SKEW_SECONDS=300
# Set when the gateway strips a path prefix from the SDK base URL, e.g. /nexus-sign
DEVICE_REQUEST_PATH_PREFIX=
WEBHOOK_REQUIRE_HTTPS=true
WEBHOOK_ALLOWED_HOSTS=
# How long after the customer's confirmation the bank may request the commit.
BANK_COMMIT_MAX_AGE_SECONDS=3600

# Secure push for bank clients in push mode NEXUS (docs/protocol/secure-push.md)
PUSH_DELIVERY_ENABLED=false
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_PRIVATE_KEY_PEM=
APNS_TOPIC=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
PUSH_MESSAGE_TTL_SECONDS=86400
# Visible APNs alert text, replaced on the device by the decrypted message.
PUSH_ALERT_TITLE=New message
PUSH_ALERT_BODY=
# Authorization request push text when the bank gives none.
PUSH_AUTHORIZATION_TITLE=Confirm payment
PUSH_AUTHORIZATION_BODY=Open the app to review and confirm.
PUSH_REPLACEMENT_TITLE=
PUSH_REPLACEMENT_BODY=

# Device attestation
GOOGLE_SERVICE_ACCOUNT_JSON=
ANDROID_PACKAGE_NAME=
APPLE_APP_ID=
APPLE_APP_ATTEST_ROOT_CA_PEM=
REQUIRE_VALID_ATTESTATION=false
ANDROID_REQUIRED_DEVICE_VERDICT=MEETS_DEVICE_INTEGRITY
ATTESTATION_MAX_AGE_SECONDS=300
# Android Keystore key attestation (docs/security/attestation.md):
# REQUIRE_STRONGBOX | REQUIRE_HARDWARE_BACKED | ALLOW_TEE | ALLOW_SOFTWARE (development only)
ANDROID_KEY_SECURITY_POLICY=REQUIRE_HARDWARE_BACKED
ANDROID_REQUIRE_LOCKED_BOOTLOADER=true
# Comma-separated SHA-256 (hex) of the app signing certificates
ANDROID_APP_CERT_SHA256=
# Google's attestation status list, downloaded and refreshed by operations
ANDROID_ATTESTATION_STATUS_FILE=

# Admin console. Set ADMIN_COOKIE_SECURE=false only for local development over plain HTTP.
ADMIN_COOKIE_SECURE=true
ADMIN_MFA_REQUIRED=true
ADMIN_APPROVAL_TTL_HOURS=24

# mTLS gateway: it must overwrite both headers on every request.
REQUIRE_MTLS_HEADER=false
MTLS_VERIFIED_HEADER=x-client-cert-verified
MTLS_CERT_SHA256_HEADER=x-client-cert-sha256
TRUSTED_PROXY_IPS=

# Production (FI-005): master keys wrapped by the HSM instead of plaintext keys above.
# MASTER_KEY_SOURCE=hsm
# PKCS11_KEK_LABEL=nexus-master-kek
# WEBHOOK_SECRET_ENCRYPTION_KEY_WRAPPED=w1$...   (node dist/cli/masterKeys.js generate webhook)
# DEVICE_SECRET_ENCRYPTION_KEY_WRAPPED=w1$...
# ADMIN_SECRET_ENCRYPTION_KEY_WRAPPED=w1$...
